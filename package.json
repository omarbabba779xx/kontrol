{
  "name": "kontrol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test:postgres": "cross-env KONTROL_TEST_DB=postgres node --conditions=react-server --import tsx --test --test-concurrency=2 \"tests/**/*.test.ts\"",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate-sqlite-to-postgres.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:postgres && npm run build",
    "test:e2e": "playwright test",
    "test:opa": "opa test infra/opa && opa check infra/opa --strict",
    "measure": "node --conditions=react-server --import tsx scripts/measure.mts",
    "keys:signing": "node --import tsx scripts/signing-key.ts",
    "ingest:secret": "node --import tsx scripts/ingest-secret.ts",
    "export:crosswalk": "node --conditions=react-server --import tsx scripts/export-crosswalk.ts",
    "test:live": "node --conditions=react-server --import tsx --test tests/live/live.test.ts",
    "db:status": "node --conditions=react-server --import tsx scripts/db.ts status",
    "db:upgrade": "node --conditions=react-server --import tsx scripts/db.ts upgrade",
    "setup": "npm ci --ignore-scripts && npm rebuild esbuild unrs-resolver",
    "verify": "node scripts/verify.mjs",
    "verify:strict": "node scripts/verify.mjs --strict --e2e",
    "backup": "node --conditions=react-server --import tsx scripts/backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.1144.0",
    "@aws-sdk/client-config-service": "^3.1143.0",
    "@aws-sdk/client-iam": "^3.1143.0",
    "@aws-sdk/client-kms": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/client-sts": "^3.1145.0",
    "@base-ui/react": "^1.8.0",
    "ai": "^7.0.124",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "16.4.0",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
