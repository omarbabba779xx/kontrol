KONTROL_AUTH_MODE=demo
KONTROL_AUTH_SECRET=replace-with-at-least-32-random-bytes
KONTROL_SIGNING_SECRET=replace-with-a-different-random-secret
# Ed25519 private key that signs decisions, reports and audit anchors. Required in production: npm run keys:signing.
KONTROL_SIGNING_KEY=
# Number of reverse proxies in front of the app that append to X-Forwarded-For. 0 (default) means the header is not believed.
KONTROL_TRUSTED_PROXY_HOPS=0
# Single sign-on: new accounts are created only for these email domains (default organisation) or domain=tenant_id pairs. Otherwise sign-in is by invitation.
OIDC_ALLOWED_DOMAINS=
OIDC_DOMAIN_TENANTS=
# Storage: sqlite (default, embedded) or postgres (forced row-level security).
KONTROL_DB_DRIVER=sqlite
KONTROL_DATABASE_PATH=.data/kontrol.db
KONTROL_DB_POOL=10
# Seed the demonstration tenant into an empty database. Set to false in production.
# "empty" creates the organisation and its administrator with no sample record (evaluation only), to work a case of your own.
KONTROL_SEED=true
# Per-actor request budget per minute.
KONTROL_RATE_LIMIT_PER_MINUTE=600
CRON_SECRET=replace-with-cron-bearer-secret
GITHUB_TOKEN=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OKTA_BASE_URL=
OKTA_API_TOKEN=
AI_GATEWAY_API_KEY=
KONTROL_AGENT_MODEL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/session/oidc/callback
OIDC_DEFAULT_TENANT_ID=tenant_acme
# Only set to true if your identity provider is authoritative for the kontrol_role claim.
OIDC_TRUST_ROLE_CLAIM=false
POSTGRES_URL=postgresql://kontrol:kontrol@localhost:5432/kontrol
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=kontrol
S3_SECRET_KEY=change-me
S3_BUCKET=kontrol-evidence
OPA_URL=http://localhost:8181
# Audit anchors: signed checkpoints of the audit chain. Interval in hours (0 disables). The sink should be write-once storage.
KONTROL_ANCHOR_INTERVAL_HOURS=24
KONTROL_ANCHOR_SINK_URL=
KONTROL_ANCHOR_SINK_TOKEN=
# Write anchors to an S3 bucket created with Object Lock (preferred over the HTTPS sink).
KONTROL_ANCHOR_S3_BUCKET=
KONTROL_ANCHOR_RETENTION_DAYS=3650
# Sign through an AWS KMS key (ECC_NIST_P256, SIGN_VERIFY) instead of a local key: the private key never enters the process.
KONTROL_SIGNING_KMS_KEY_ID=
# Show the modules that work on modelled or synthetic data (digital twin, attack paths, benchmarking).
NEXT_PUBLIC_KONTROL_LABS=false
